# Copy to .env.local and fill in values. Never commit .env.local.

# Backend API origin. Omit to use production (https://api.courtvision.dev);
# set to http://127.0.0.1:8000 when running the backend locally.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# SQLMate (query builder) origin. Omit to use production.
# NEXT_PUBLIC_SQLMATE_ORIGIN=http://127.0.0.1:8100

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/your-teams
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/your-teams
