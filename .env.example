# Copy to .env.local and fill in values. Never commit .env.local.

# Backend API origin. Omit to use production (https://api.courtvision.dev);
# set to http://127.0.0.1:8000 when running the backend locally.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# SQLMate (query builder) origin. Omit to use production.
# NEXT_PUBLIC_SQLMATE_ORIGIN=http://127.0.0.1:8100

# Draft Tap extension id — enables live ESPN draft sync in the draft room.
# It is the id chrome://extensions shows for the unpacked Draft Tap extension
# (pinned by its manifest "key"). Omit to disable sync; the room stays fully
# usable by hand without it.
# NEXT_PUBLIC_DRAFT_TAP_EXTENSION_ID=emchocgopfngbgklfflaoagohjceofpd

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/your-teams
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/manage-teams

# Sentry — https://sentry.io. Leave NEXT_PUBLIC_SENTRY_DSN unset to disable
# error reporting (the SDK is a no-op without a DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source-map upload (optional; Vercel's Sentry integration can set these)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
